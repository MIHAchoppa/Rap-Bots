# === REQUIRED ENVIRONMENT VARIABLES ===

# Database Configuration (REQUIRED)
# On Replit: Use Replit's PostgreSQL database
# Locally: Use a PostgreSQL connection string
# Example: postgresql://user:password@localhost:5432/rapbots
DATABASE_URL=

# Session Secret (REQUIRED)
# Generate a random string for production
# Example: openssl rand -base64 32
SESSION_SECRET=

# Replit Configuration (Required on Replit, auto-provided)
# These are automatically set by Replit
REPL_ID=
REPLIT_DOMAINS=

# AI Services (REQUIRED for rap battles)
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=

# === OPTIONAL ENVIRONMENT VARIABLES ===

# Alternative AI Service
# Optional: Use OpenAI instead of or in addition to Groq
OPENAI_API_KEY=

# Text-to-Speech Services
# Optional: For advanced voice features
ELEVENLABS_API_KEY=

# Payment Processing
# Optional: For subscriptions and purchases
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Advanced Configuration
# Optional: Customize default models and settings
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile

# === DEVELOPMENT-ONLY ===
# These are only needed for local development

# Node Environment
NODE_ENV=development

# Server Port (default: 5000)
PORT=5000

