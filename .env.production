NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=postgresql://rapuser:securepassword@db:5432/rapbots

# Storage (S3 or MinIO) - fill with your real credentials / endpoints
S3_ENDPOINT=http://minio:9000
S3_BUCKET=rapbots-models
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio_access_key
S3_SECRET_ACCESS_KEY=minio_secret_key
S3_FORCE_PATH_STYLE=true

# External APIs -- fill real keys
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=

# Model artifact locations (HTTP or S3 signed URLs)
MODEL_ARTALK_REMOTE_URL=https://example.com/artalk-checkpoint.tar.gz
MODEL_MUSETALK_REMOTE_URL=https://example.com/musetalk-checkpoint.tar.gz

# Redis and other services
REDIS_URL=redis://redis:6379
SESSION_SECRET=replace-with-a-secure-secret
LOG_LEVEL=info
